@model demoBE.Models.ViewModel.Cart
@{
    ViewBag.Title = "Giỏ hàng nâng cao";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}
@section styles { <link href="@Url.Content("~/Content/myStyle/Cart.css")" rel="stylesheet" /> }
<section class="cart-heading"><div><p class="text-uppercase">Giỏ hàng nâng cao</p><h1>Giỏ hàng theo danh mục</h1></div><a class="btn btn-outline-secondary" href="@Url.Action("Index")">Giỏ hàng cơ bản</a></section>
@if (!Model.Items.Any())
{
    <div class="cart-empty"><h2>Giỏ hàng đang trống</h2><p>Thêm sản phẩm để nhận gợi ý cùng danh mục.</p><a class="btn btn-primary" href="@Url.Action("Index", "Home")">Tiếp tục mua hàng</a></div>
}
else
{
    <div class="cart-layout"><div class="cart-items">
        @foreach (var group in Model.GroupedItems)
        {
            <section class="cart-category-group"><h2>@group.Key</h2>
                @foreach (var item in group)
                {
                    <article class="cart-item"><div class="cart-item-info"><h3>@item.ProductName</h3><p>@item.UnitPrice.ToString("N0") ₫ mỗi sản phẩm</p></div><div class="cart-item-action">@using (Html.BeginForm("UpdateSelection", "Cart", FormMethod.Post, new { @class = "cart-inline-form" })) { @Html.AntiForgeryToken() @Html.Hidden("productID", item.ProductID) @Html.Hidden("advanced", true) <input type="hidden" name="isSelected" value="false" /><input class="form-check-input" type="checkbox" name="isSelected" value="true" checked="@(item.IsSelected ? "checked" : null)" onchange="this.form.submit()" /> } @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { @class = "cart-inline-form" })) { @Html.AntiForgeryToken() @Html.Hidden("productID", item.ProductID) @Html.Hidden("advanced", true) <input class="form-control" type="number" name="quantity" min="1" max="99" value="@item.Quantity" /><button class="btn btn-sm btn-outline-primary" type="submit">Cập nhật</button> }<span class="cart-line-total">@item.TotalPrice.ToString("N0") ₫</span>@using (Html.BeginForm("RemoveFromCart", "Cart", FormMethod.Post, new { @class = "cart-inline-form" })) { @Html.AntiForgeryToken() @Html.Hidden("productID", item.ProductID) @Html.Hidden("advanced", true) <button class="btn btn-sm btn-link text-danger" type="submit">Xóa</button> }</div></article>
                }
            </section>
        }
    </div><aside class="cart-summary"><h2>Tổng thanh toán</h2><p class="cart-total">@Model.SelectedTotalValue.ToString("N0") ₫</p><a class="btn btn-primary w-100" href="@Url.Action("Checkout")">Mua hàng</a>@using (Html.BeginForm("ClearCart", "Cart", FormMethod.Post, new { @class = "mt-2" })) { @Html.AntiForgeryToken() @Html.Hidden("advanced", true) <button class="btn btn-link text-danger w-100" type="submit">Xóa hết giỏ hàng</button> }</aside></div>
    @Html.Partial("_PVSimilarProduct", Model)
}
