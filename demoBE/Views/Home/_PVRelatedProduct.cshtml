@model demoBE.Models.ViewModel.ProductDetailVM
<section class="detail-section" aria-labelledby="relatedTitle">
    <h2 id="relatedTitle">Sản phẩm tương tự</h2>
    @if (Model.RelatedProducts.Any())
    {
        <div class="related-track">
            @foreach (var product in Model.RelatedProducts)
            {
                var imageUrl = string.IsNullOrWhiteSpace(product.ProductImage) ? Url.Content("~/Content/images/product-placeholder.svg") : Url.Content(product.ProductImage);
                <article class="related-card"><a href="@Url.Action("ProductDetail", "Home", new { id = product.ProductID })"><img src="@imageUrl" alt="@product.ProductName" onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/product-placeholder.svg")';" /></a><h3><a href="@Url.Action("ProductDetail", "Home", new { id = product.ProductID })">@product.ProductName</a></h3><strong>@product.ProductPrice.ToString("N0") ₫</strong></article>
            }
        </div>
    }
    else { <p class="empty-state">Chưa có sản phẩm tương tự.</p> }
</section>
