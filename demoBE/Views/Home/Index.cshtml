@model demoBE.Models.ViewModel.HomeProductVM
@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}
@section styles { <link href="@Url.Content("~/Content/myStyle/CustomerHome.css")" rel="stylesheet" /> }
<section class="customer-hero">
    <div>
        <p class="text-uppercase mb-2">MyStore</p>
        <h1>Mua sắm theo nhu cầu của bạn</h1>
        <p class="mb-0">Khám phá sản phẩm theo danh mục, giá và thông tin thực tế từ MyStore.</p>
    </div>
</section>
<section class="search-panel" aria-label="Tìm kiếm sản phẩm">
    @using (Html.BeginForm("Index", "Home", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
    {
        <div class="col-md-9"><label class="form-label" for="searchTerm">Tìm sản phẩm</label><input class="form-control" id="searchTerm" name="searchTerm" value="@Model.SearchTerm" placeholder="Tên, mô tả hoặc danh mục" /></div>
        <div class="col-md-3 d-grid"><button class="btn btn-primary" type="submit">Tìm kiếm</button></div>
    }
</section>
@if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
{
    <p class="text-muted">Có @Model.TotalMatchingProducts kết quả cho “@Model.SearchTerm”.</p>
}
@Html.Partial("_PVFeatureProduct", Model)
@Html.Partial("_PVNewProduct", Model)
