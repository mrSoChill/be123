@using PagedList.Mvc
@model demoBE.Models.ViewModel.HomeProductVM
<section class="product-section" aria-labelledby="newTitle">
    <div class="section-heading"><h2 id="newTitle">Danh sách sản phẩm mới</h2><span>Ưu tiên sản phẩm ít được mua theo yêu cầu bài tập</span></div>
    @if (Model.NewProducts != null && Model.NewProducts.Any())
    {
        <div class="product-grid">
            @foreach (var product in Model.NewProducts)
            {
                var imageUrl = string.IsNullOrWhiteSpace(product.ProductImage) ? Url.Content("~/Content/images/product-placeholder.svg") : Url.Content(product.ProductImage);
                <article class="product-card">
                    <a href="@Url.Action("ProductDetail", "Home", new { id = product.ProductID })"><img src="@imageUrl" alt="@product.ProductName" onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/product-placeholder.svg")';" /></a>
                    <div class="product-card-body"><p class="product-category">@(product.Category == null ? "Chưa phân loại" : product.Category.CategoryName)</p><h3><a href="@Url.Action("ProductDetail", "Home", new { id = product.ProductID })">@product.ProductName</a></h3><strong>@product.ProductPrice.ToString("N0") ₫</strong></div>
                </article>
            }
        </div>
        @Html.PagedListPager(Model.NewProducts, currentPage => Url.Action("Index", new { searchTerm = Model.SearchTerm, page = currentPage }), new PagedListRenderOptions { LiElementClasses = new[] { "page-item" } })
    }
    else
    {
        <p class="empty-state">Không có sản phẩm phù hợp với tìm kiếm hiện tại.</p>
    }
</section>
