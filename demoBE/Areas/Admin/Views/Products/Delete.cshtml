@model demoBE.Models.Product
@{
    ViewBag.Title = "Xóa sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-danger text-white">Xóa sản phẩm</div>
    <div class="card-body">
        <p>Bạn có chắc muốn xóa sản phẩm này?</p>
        @Html.Partial("PVProductInfo", Model)
        <p class="text-muted mt-3">Sản phẩm đã có chi tiết đơn hàng tham chiếu sẽ không thể xóa.</p>
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
            @Html.ActionLink("Hủy", "Index", null, new { @class = "btn btn-outline-secondary" })
        }
    </div>
</div>
