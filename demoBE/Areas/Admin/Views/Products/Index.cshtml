@model demoBE.Models.ViewModel.ProductSearchVM
@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var sortOptions = new[]
    {
        new SelectListItem { Text = "Tên sản phẩm: A đến Z", Value = "name_asc" },
        new SelectListItem { Text = "Tên sản phẩm: Z đến A", Value = "name_desc" },
        new SelectListItem { Text = "Giá: thấp đến cao", Value = "price_asc" },
        new SelectListItem { Text = "Giá: cao đến thấp", Value = "price_desc" }
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Quản lý sản phẩm</h1>
    @Html.ActionLink("Thêm sản phẩm", "Create", null, new { @class = "btn btn-primary" })
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
}

<div class="card shadow-sm border-0 mb-3">
    <div class="card-header bg-primary text-white">Tìm kiếm và sắp xếp</div>
    <div class="card-body">
        @using (Html.BeginForm("Index", "Products", new { area = "Admin" }, FormMethod.Get, new { @class = "row g-3 align-items-end" }))
        {
            <div class="col-12 col-lg-4">
                @Html.Label("searchTerm", "Tên, mô tả hoặc danh mục", new { @class = "form-label" })
                @Html.TextBox("searchTerm", Model.SearchTerm, new { @class = "form-control", placeholder = "Nhập từ khóa cần tìm" })
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                @Html.Label("minPrice", "Giá từ", new { @class = "form-label" })
                @Html.TextBox("minPrice", Model.MinPrice, new { @class = "form-control", type = "number", min = "0", step = "1", placeholder = "0" })
                @Html.ValidationMessage("minPrice", new { @class = "text-danger small" })
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                @Html.Label("maxPrice", "Giá đến", new { @class = "form-label" })
                @Html.TextBox("maxPrice", Model.MaxPrice, new { @class = "form-control", type = "number", min = "0", step = "1", placeholder = "Không giới hạn" })
                @Html.ValidationMessage("maxPrice", new { @class = "text-danger small" })
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                @Html.Label("sortOrder", "Sắp xếp", new { @class = "form-label" })
                @Html.DropDownList("sortOrder", new SelectList(sortOptions, "Value", "Text", Model.SortOrder), new { @class = "form-select" })
            </div>
            <div class="col-12 col-sm-6 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Tìm kiếm</button>
                @Html.ActionLink("Đặt lại", "Index", null, new { @class = "btn btn-outline-secondary" })
            </div>
            <div class="col-12">
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-0" })
            </div>
        }
    </div>
</div>

@Html.Partial("PVListProduct", Model)
