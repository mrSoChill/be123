@model demoBE.Models.Product
@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-secondary text-white">Chi tiết sản phẩm</div>
    <div class="card-body">
        @Html.Partial("PVProductInfo", Model)
        <div class="mt-3">
            @Html.ActionLink("Sửa", "Edit", new { id = Model.ProductID }, new { @class = "btn btn-primary" })
            @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-outline-secondary" })
        </div>
    </div>
</div>
