@model demoBE.Models.ViewModel.ProductSearchVM
@using PagedList.Mvc

<div class="card shadow-sm border-0">
    <div class="card-header bg-primary text-white d-flex flex-wrap justify-content-between gap-2">
        <span>Danh sách sản phẩm</span>
        <span class="small">Tổng cộng: @Model.Products.TotalItemCount sản phẩm</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã</th>
                    <th>Tên sản phẩm</th>
                    <th>Mô tả</th>
                    <th>Danh mục</th>
                    <th class="text-end">Giá</th>
                    <th>Hình ảnh</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Products.Any())
                {
                    foreach (var item in Model.Products)
                    {
                        <tr>
                            <td>@item.ProductID</td>
                            <td><strong>@item.ProductName</strong></td>
                            <td>@item.ProductDecription</td>
                            <td>@(item.Category == null ? "-" : item.Category.CategoryName)</td>
                            <td class="text-end">@item.ProductPrice.ToString("N0") ₫</td>
                            <td>@(string.IsNullOrWhiteSpace(item.ProductImage) ? "-" : item.ProductImage)</td>
                            <td class="text-end text-nowrap">
                                @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }, new { @class = "btn btn-sm btn-outline-secondary" })
                                @Html.ActionLink("Sửa", "Edit", new { id = item.ProductID }, new { @class = "btn btn-sm btn-outline-primary" })
                                @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID }, new { @class = "btn btn-sm btn-outline-danger" })
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Không tìm thấy sản phẩm phù hợp.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Products.TotalItemCount > 0)
    {
        <div class="card-body border-top d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="text-muted small">Hiển thị @Model.Products.FirstItemOnPage - @Model.Products.LastItemOnPage trên @Model.Products.TotalItemCount sản phẩm</span>

            @if (Model.Products.PageCount > 1)
            {
                var firstPage = Math.Max(1, Model.Products.PageNumber - 2);
                var lastPage = Math.Min(Model.Products.PageCount, firstPage + 4);
                firstPage = Math.Max(1, lastPage - 4);

                <nav aria-label="Phân trang sản phẩm">
                    <ul class="pagination mb-0">
                        @if (Model.Products.HasPreviousPage)
                        {
                            <li class="page-item">
                                @Html.ActionLink("Trước", "Index", new { searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = Model.SortOrder, page = Model.Products.PageNumber - 1 }, new { @class = "page-link" })
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled"><span class="page-link">Trước</span></li>
                        }

                        @for (var pageNumber = firstPage; pageNumber <= lastPage; pageNumber++)
                        {
                            if (pageNumber == Model.Products.PageNumber)
                            {
                                <li class="page-item active" aria-current="page"><span class="page-link">@pageNumber</span></li>
                            }
                            else
                            {
                                <li class="page-item">
                                    @Html.ActionLink(pageNumber.ToString(), "Index", new { searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = Model.SortOrder, page = pageNumber }, new { @class = "page-link" })
                                </li>
                            }
                        }

                        @if (Model.Products.HasNextPage)
                        {
                            <li class="page-item">
                                @Html.ActionLink("Sau", "Index", new { searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = Model.SortOrder, page = Model.Products.PageNumber + 1 }, new { @class = "page-link" })
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled"><span class="page-link">Sau</span></li>
                        }
                    </ul>
                </nav>
            }
        </div>
    }
</div>
