@model demoBE.Models.Category
@{
    ViewBag.Title = "Chi tiết danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-secondary text-white">Chi tiết danh mục</div>
    <div class="card-body">
        <dl class="row mb-3">
            <dt class="col-sm-3">Mã danh mục</dt><dd class="col-sm-9">@Model.CategoryID</dd>
            <dt class="col-sm-3">Tên danh mục</dt><dd class="col-sm-9">@Model.CategoryName</dd>
        </dl>
        @Html.ActionLink("Sửa", "Edit", new { id = Model.CategoryID }, new { @class = "btn btn-primary" })
        @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
</div>
