@model demoBE.Models.Category

@Html.ValidationSummary(true, "", new { @class = "text-danger" })
<div class="mb-3">
    @Html.LabelFor(model => model.CategoryName, "Tên danh mục", new { @class = "form-label" })
    @Html.TextBoxFor(model => model.CategoryName, new { @class = "form-control", maxlength = "255", autocomplete = "off" })
    @Html.ValidationMessageFor(model => model.CategoryName, "", new { @class = "text-danger" })
</div>
