<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - MyStore Admin</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            @Html.ActionLink("MyStore Admin", "Index", "Home", new { area = "Admin" }, new { @class = "navbar-brand" })
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavigation" aria-controls="adminNavigation" aria-expanded="false" aria-label="Mở menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="adminNavigation">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">@Html.ActionLink("Trang quản trị", "Index", "Home", new { area = "Admin" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Danh mục", "Index", "Categories", new { area = "Admin" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Sản phẩm", "Index", "Products", new { area = "Admin" }, new { @class = "nav-link" })</li>
                </ul>
                @Html.ActionLink("Về trang chủ", "Index", "Home", new { area = "" }, new { @class = "btn btn-outline-light btn-sm" })
            </div>
        </div>
    </nav>
    <main class="container pb-4">
        @RenderBody()
    </main>
    <footer class="border-top bg-white py-3 text-center text-muted">
        <small>&copy; @DateTime.Now.Year - MyStore Administration</small>
    </footer>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
